@Metadata.layer: #CORE
@UI: {
  headerInfo: { typeName: 'Server Rack',
                typeNamePlural: 'Server Racks',
                title: { type: #STANDARD, value: 'ProjectName' } } }
annotate view ZC_SERVER_HEAD
  with 
{
  @UI.facet: [ 
    { id: 'RackInfo', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Rack Details', position: 10 },
    { id: 'Items', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Components', position: 20, targetElement: '_Items' } 
  ]

  @UI.hidden: true
  ConfigUuid;

  @UI: { lineItem: [ { position: 10 } ], identification: [ { position: 10 } ], selectionField: [ { position: 10 } ] }
  ProjectName;

  @UI: { lineItem: [ { position: 20 } ], identification: [ { position: 20 } ] }
  CustomerId;

  @UI: { lineItem: [ { position: 30 } ], identification: [ { position: 30 } ] }
  TotalPrice;

  @UI: { lineItem: [ { position: 40 } ], identification: [ { position: 40 } ] }
  TotalPowerW;

  @UI: { lineItem: [ { position: 50 } ], identification: [ { position: 50 } ] }
  TotalSpaceU;
}