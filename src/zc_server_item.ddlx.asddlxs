@Metadata.layer: #CORE
@UI: {
  headerInfo: { typeName: 'Component',
                typeNamePlural: 'Components',
                title: { type: #STANDARD, value: 'ComponentId' } } }
annotate view ZC_SERVER_ITEM
  with 
{
  @UI.facet: [ { id: 'ItemInfo', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Component Details', position: 10 } ]

  @UI.hidden: true
  ItemUuid;
  
  @UI.hidden: true
  ConfigUuid;

  @UI: { lineItem: [ { position: 10 } ], identification: [ { position: 10 } ] }
  ComponentId;

  @UI: { lineItem: [ { position: 20 } ], identification: [ { position: 20 } ] }
  ComponentType;

  @UI: { lineItem: [ { position: 30 } ], identification: [ { position: 30 } ] }
  Quantity;

  @UI: { lineItem: [ { position: 40 } ], identification: [ { position: 40 } ] }
  PricePerUnit;

  @UI: { lineItem: [ { position: 50 } ], identification: [ { position: 50 } ] }
  PowerWPerUnit;

  @UI: { lineItem: [ { position: 60 } ], identification: [ { position: 60 } ] }
  SpaceUPerUnit;
}